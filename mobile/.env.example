# Base URL of the deployed Next.js backend (no trailing slash).
# For local device testing, use your machine's LAN IP:
#   e.g. http://192.168.1.42:3000  (find with `ifconfig` / `ipconfig`)
# For production, use your Vercel deployment URL.
EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# Google Maps SDK keys — used for MAP TILE RENDERING only.
# These are SEPARATE from the server-side GOOGLE_PLACES_API_KEY.
# Create two credentials in Google Cloud Console:
#   iOS key  → restrict to iOS app, bundle ID: com.localcoffee.app
#   Android  → restrict to Android app, package + SHA-1 fingerprint
# Both keys need "Maps SDK for iOS" / "Maps SDK for Android" enabled.
GOOGLE_MAPS_IOS_SDK_KEY=AIza...
GOOGLE_MAPS_ANDROID_SDK_KEY=AIza...
